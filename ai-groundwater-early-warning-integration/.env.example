DATABASE_URL=postgresql+psycopg://groundwater:change-me@db:5432/groundwater
GROUNDWATER_RAW_PATH=
VITE_API_BASE_URL=http://localhost:8000
*** Add File: ai-groundwater-early-warning-integration/docker-compose.yml
services:
  db:
    image: postgis/postgis:16-3.4
    environment:
      POSTGRES_DB: groundwater
      POSTGRES_USER: groundwater
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set-in-.env}
    ports: ["5432:5432"]
    volumes: ["postgres-data:/var/lib/postgresql/data"]
  api:
    build: ../member-5-backend-database
    env_file: .env
    depends_on: [db]
    ports: ["8000:8000"]
  web:
    build: ../member-4-gis-frontend
    environment: ["VITE_API_BASE_URL=http://localhost:8000"]
    depends_on: [api]
    ports: ["5173:80"]
volumes:
  postgres-data:
